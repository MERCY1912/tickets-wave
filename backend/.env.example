# Turso Database
DATABASE_URL=libsql://tickets-wave-db-blxxd.aws-eu-west-1.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# JWT Secret (change this to a random string at least 32 characters)
JWT_SECRET=change-this-to-a-secure-random-string-min-32-characters

# DeepSeek API (optional - users can set their own key)
# Get your API key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Server
PORT=3001
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
