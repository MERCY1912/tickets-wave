# Database
DATABASE_URL=file:./dev.db

# Turso Cloud Database (optional, for future use)
# To use Turso instead of local SQLite:
# 1. Sign up at https://turso.tech
# 2. Create a database: turso db create tickets-wave-db
# 3. Get auth token: turso db tokens create tickets-wave-db
# 4. Update DATABASE_URL and add TURSO_AUTH_TOKEN
# DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-auth-token

# JWT Secret (change this to a random string at least 32 characters)
JWT_SECRET=change-this-to-a-secure-random-string-min-32-characters

# DeepSeek API (optional - users can set their own key)
# Get your API key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Server
PORT=3001
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
