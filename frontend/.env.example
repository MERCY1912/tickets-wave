# Vercel Environment Variables
# Set these in Vercel dashboard for your project

# Turso Database (required)
DATABASE_URL=libsql://tickets-wave-db-blxxd.aws-eu-west-1.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# JWT Secret (required - change to a random string at least 32 characters)
JWT_SECRET=change-this-to-a-secure-random-string-min-32-characters

# DeepSeek API (optional - users can set their own key in settings)
DEEPSEEK_API_KEY=

# API URL - Only set this if using separate backend during development
# For Vercel deployment, leave empty to use local API routes
# VITE_API_URL=http://localhost:3001/api
